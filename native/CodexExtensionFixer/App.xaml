<Application x:Class="CodexExtensionFixer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PrimaryText" Color="#F6F8FF"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#9BAAC7"/>
    <SolidColorBrush x:Key="SoftBorder" Color="#44DCEBFF"/>
    <Style x:Key="GlassCard" TargetType="Border">
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4C667EAC" Offset="0"/>
            <GradientStop Color="#28404C73" Offset="0.55"/>
            <GradientStop Color="#28303C63" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="BorderBrush">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#90E1EFFF" Offset="0"/>
            <GradientStop Color="#22CEE8FF" Offset="0.42"/>
            <GradientStop Color="#3589B0E0" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="24"/>
      <Setter Property="Padding" Value="23"/>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect Color="#060F2D" BlurRadius="22" ShadowDepth="7" Opacity="0.32"/>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GlassButton" TargetType="Button">
      <Setter Property="Foreground" Value="#EFF5FF"/>
      <Setter Property="Background" Value="#354B6E96"/>
      <Setter Property="BorderBrush" Value="#65BCD9FA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18,12"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonShell" CornerRadius="14"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonShell" Property="Background" Value="#6679A5D5"/>
                <Setter TargetName="ButtonShell" Property="BorderBrush" Value="#B3E8F5FF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonShell" Property="Opacity" Value="0.73"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonShell" Property="Opacity" Value="0.35"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>